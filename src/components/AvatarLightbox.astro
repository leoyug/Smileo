---
import Button from "./Button.astro";
import Card from "./Card.astro";
import ProgressiveBlur from "./ProgressiveBlur.astro";
import TextLink from "./TextLink.astro";
import { fitnessRingNames } from "../lib/avatar-fitness";

interface Props {
  id: string;
  demo?: boolean;
}

const { id, demo = false } = Astro.props;
const assets = "/assets/figma/avatar-lightbox";
const ringLayout = {
  move: { radius: 53.478, iconTop: 0, label: "活动环" },
  exercise: { radius: 38.696, iconTop: 14.782, label: "锻炼环" },
  stand: { radius: 23.913, iconTop: 29.565, label: "站立环" },
};
const dailyPreview = {
  entries: [
    { id: "example-1", body: "示例 · 今天整理了最近几个界面的设计笔记，记下了两个以后还想试试的细节。", url: null, title: null, publishedAt: Date.parse("2026-11-26T04:25:00Z") },
    { id: "example-2", body: "示例 · 分享一个阅读链接。", url: "https://example.com", title: "一则链接分享", publishedAt: Date.parse("2026-11-24T08:12:00Z") },
    { id: "example-3", body: "示例 · 上个月的记录。", url: null, title: null, publishedAt: Date.parse("2026-10-28T12:27:00Z") },
  ],
  nextCursor: null,
};
---

<dialog id={id} class="avatar-lightbox" data-avatar-lightbox aria-label="Leo 的个人状态">
  <div class="avatar-lightbox__layout" data-avatar-layout>
    <p class="avatar-lightbox__close-hint">按 ESC 退出</p>
    <div class="avatar-lightbox__overview">
      <div class="avatar-lightbox__intro">
        <figure class="avatar-lightbox__portrait avatar-lightbox__module">
          <div class="avatar-lightbox__portrait-art">
            <div class="avatar-lightbox__portrait-orbit">
              <img class="avatar-lightbox__photo" src={`${assets}/portrait.webp`} alt="Leo 在海边穿着黑色上衣，比出剪刀手" width="150" height="197" loading="lazy" draggable="false" tabindex="0" aria-describedby={`${id}-portrait-help`} aria-keyshortcuts="ArrowLeft ArrowRight Home" />
            </div>
            <span class="avatar-lightbox__pin" aria-hidden="true">
              <img class="avatar-lightbox__pin-shadow" src={`${assets}/pin-shadow.svg`} alt="" loading="lazy" />
              <img class="avatar-lightbox__pin-highlight" src={`${assets}/pin-highlight.svg`} alt="" loading="lazy" />
              <img class="avatar-lightbox__pin-head" src={`${assets}/pin.webp`} alt="" width="13" height="13" loading="lazy" />
            </span>
          </div>
          <span class="sr-only" id={`${id}-portrait-help`}>拖动照片或按左右方向键旋转，按 Home 复位。</span>
        </figure>
        <Card class="avatar-lightbox__module avatar-lightbox__card avatar-lightbox__weather" variant="media">
          <div class="avatar-lightbox__card-body">
            <h2><img src={`${assets}/weather.svg`} alt="" width="20" height="20" loading="lazy" />天气</h2>
            <div class="avatar-lightbox__temperature">
              <p>9℃</p>
              <p>多云</p>
            </div>
          </div>
        </Card>
      </div>

      <Card class="avatar-lightbox__module avatar-lightbox__card" variant="media">
        <div class="avatar-lightbox__card-body">
          <h2><img src={`${assets}/social.svg`} alt="" width="16" height="16" loading="lazy" />社媒</h2>
          <div class="avatar-lightbox__social-slots" aria-hidden="true">
            {Array.from({ length: 6 }, () => <span></span>)}
          </div>
          <p class="sr-only">社交链接待补充</p>
        </div>
      </Card>

      <div class="avatar-lightbox__status">
        <Card class="avatar-lightbox__module avatar-lightbox__card avatar-lightbox__availability" variant="media">
          <div class="avatar-lightbox__card-body">
            <h2><img src={`${assets}/presence.svg`} alt="" width="20" height="20" loading="lazy" />状态</h2>
            <p class="avatar-lightbox__presence" data-avatar-presence="offline" role="status">
              <span data-presence-offline>离线</span>
              <span data-presence-online hidden>在线</span>
            </p>
          </div>
        </Card>
        <Card class="avatar-lightbox__module avatar-lightbox__card avatar-lightbox__fitness" variant="media">
          <div class="avatar-lightbox__card-body" data-avatar-fitness>
            <h2><img src={`${assets}/fitness.svg`} alt="" width="20" height="20" loading="lazy" />健身</h2>
            <svg class="avatar-lightbox__rings" viewBox="0 0 120 120" width="120" height="120" aria-hidden="true">
              {fitnessRingNames.map(name => (
                <g class:list={["avatar-lightbox__ring", `avatar-lightbox__ring--${name}`]} data-fitness-ring={name}>
                  <circle class="avatar-lightbox__ring-track" cx="60" cy="60" r={ringLayout[name].radius} />
                  <circle class="avatar-lightbox__ring-progress" data-fitness-arc cx="60" cy="60" r={ringLayout[name].radius} pathLength="100" visibility="hidden" />
                  <circle class="avatar-lightbox__ring-lap" data-fitness-lap cx="60" cy="60" r={ringLayout[name].radius} pathLength="100" visibility="hidden" />
                  <image href={`${assets}/ring-${name}-arrow.svg`} x="53.478" y={ringLayout[name].iconTop} width="13.044" height="13.044" />
                </g>
              ))}
            </svg>
            <ul class="sr-only" aria-live="polite" role="list">
              {fitnessRingNames.map(name => (
                <li data-fitness-value={name} hidden>{ringLayout[name].label} <span></span></li>
              ))}
            </ul>
            <p class="avatar-lightbox__steps">
              <img src={`${assets}/steps.svg`} alt="" width="24" height="24" loading="lazy" />
              <span data-fitness-steps>—</span><span class="sr-only" data-fitness-steps-unit hidden>步</span>
            </p>
          </div>
        </Card>
        <div class="avatar-lightbox__location avatar-lightbox__module" data-avatar-clock role="group" aria-label="时区与概略位置">
          <div class="avatar-lightbox__location-row">
            <span class="avatar-lightbox__clock-face" aria-hidden="true">
              <img src={`${assets}/clock.svg`} alt="" width="32" height="32" loading="lazy" />
              <span class="avatar-lightbox__clock-hour"></span>
              <span class="avatar-lightbox__clock-minute"></span>
              <span class="avatar-lightbox__clock-second"></span>
            </span>
            <div>
              <p>UTC+8</p>
              <time class="avatar-lightbox__clock-time"><span data-clock-digits>--:--</span> <span data-clock-period></span></time>
            </div>
          </div>
          <div class="avatar-lightbox__location-row" role="group" aria-label="上海概略坐标">
            <img src={`${assets}/globe.svg`} alt="" width="32" height="32" loading="lazy" />
            <div><p>121.47° E</p><p>31.23° N</p></div>
          </div>
        </div>
      </div>
    </div>

    <Card class="avatar-lightbox__module avatar-lightbox__card avatar-lightbox__activity" variant="media">
      <div class="avatar-lightbox__card-body">
        <div class="avatar-lightbox__activity-head">
          <h2 id={`${id}-activity`}><img src={`${assets}/reading.svg`} alt="" width="18" height="18" loading="lazy" />动态</h2>
          <TextLink href="/daily/" class="avatar-lightbox__activity-archive" data-daily-archive hidden>全部动态</TextLink>
        </div>
        <div class="avatar-lightbox__activity-scroll" data-avatar-activity role="region" aria-labelledby={`${id}-activity`} tabindex="0">
          <div class="avatar-lightbox__activity-status" data-daily-status role="status">
            <p data-daily-loading hidden>正在加载动态…</p>
            <p data-daily-empty hidden>还没有公开动态。</p>
            <p data-daily-error hidden>暂时无法读取动态。</p>
          </div>
          <p class="avatar-lightbox__activity-language">动态以中文发布。 <TextLink href="/daily/" hreflang="zh-CN">阅读中文动态</TextLink></p>
          <ol class="avatar-lightbox__activity-list" data-daily-list hidden></ol>
          <template data-daily-template>
              <li class="avatar-lightbox__activity-entry">
                <div class="avatar-lightbox__activity-date">
                  <a href="/daily/" data-daily-date>
                    <time>
                      <small data-daily-month></small>
                      <span data-daily-day></span>
                      <small data-daily-clock></small>
                    </time>
                  </a>
                </div>
                <div class="avatar-lightbox__activity-copy">
                  <p data-daily-body></p>
                  <TextLink href="/daily/" class="avatar-lightbox__reading-preview" data-daily-link>
                    <span data-daily-link-title></span><small data-daily-link-domain></small>
                  </TextLink>
                  <TextLink href="/daily/" class="avatar-lightbox__activity-more" data-daily-read>阅读完整动态</TextLink>
                </div>
              </li>
          </template>
          {demo && <script is:inline type="application/json" data-daily-preview set:html={JSON.stringify(dailyPreview)} />}
        </div>
      </div>
    </Card>
  </div>
  <form class="avatar-lightbox__dismiss" method="dialog">
    <ProgressiveBlur class="avatar-lightbox__dismiss-backdrop" />
    <Button class="avatar-lightbox__close" type="submit" variant="ghost" aria-label="关闭个人状态" aria-keyshortcuts="Escape" autofocus>
      关闭
    </Button>
  </form>
</dialog>

<script>
  import { cssTimeToMilliseconds } from "../lib/css-time";
  import { bindAvatarPortrait } from "../scripts/avatar-lightbox-portrait";
  import { bindAvatarFitness } from "../scripts/avatar-lightbox-fitness";
  import { bindAvatarActivity } from "../scripts/avatar-lightbox-activity";

  const initialized = new WeakSet<HTMLDialogElement>();
  const localTime = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Shanghai",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  });

  function bindAvatarClock(dialog: HTMLDialogElement) {
    const clock = dialog.querySelector<HTMLElement>("[data-avatar-clock]");
    const time = clock?.querySelector("time");
    const digits = time?.querySelector("[data-clock-digits]");
    const period = time?.querySelector("[data-clock-period]");
    const secondHand = clock?.querySelector<HTMLElement>(".avatar-lightbox__clock-second");
    if (!clock || !time || !digits || !period || !secondHand) return;

    let timer: number | undefined;
    let shownMinute: number | undefined;
    const listeners = new AbortController();

    const refresh = () => {
      window.clearTimeout(timer);
      if (!dialog.isConnected || !dialog.open || document.hidden) return;

      const now = new Date();
      const minuteStamp = Math.floor(now.getTime() / 60_000);
      if (shownMinute !== minuteStamp) {
        shownMinute = minuteStamp;
        const formatted = localTime.format(now);
        const [hour, minute] = formatted.split(":");
        const twelveHour = Number(hour) % 12;
        time.dateTime = formatted;
        digits.textContent = `${twelveHour || 12}:${minute}`;
        period.textContent = Number(hour) < 12 ? "AM" : "PM";
        clock.style.setProperty("--clock-hour-angle", `${twelveHour * 30 + Number(minute) / 2}deg`);
        clock.style.setProperty("--clock-minute-angle", `${Number(minute) * 6}deg`);
      }
      secondHand.style.transform = `rotate(${now.getUTCSeconds() * 6 - 90}deg)`;
      timer = window.setTimeout(refresh, 1000 - (now.getTime() % 1000));
    };

    dialog.addEventListener("close", refresh, { signal: listeners.signal });
    document.addEventListener("visibilitychange", refresh, { signal: listeners.signal });
    document.addEventListener("astro:before-swap", () => {
      window.clearTimeout(timer);
      listeners.abort();
    }, { once: true, signal: listeners.signal });

    return refresh;
  }

  function bindAvatarLayoutMotion(dialog: HTMLDialogElement, layout: HTMLElement | null) {
    if (!layout || !window.ResizeObserver || !CSS.supports("translate", "1px 1px")) return;

    const modules = [...layout.querySelectorAll<HTMLElement>(
      ".avatar-lightbox__card, .avatar-lightbox__portrait-art, .avatar-lightbox__location-row",
    )].map((element) => ({ element, motionElement: element.closest(".avatar-lightbox__module") }));
    const socialSlots = layout.querySelector<HTMLElement>(".avatar-lightbox__social-slots");
    const clock = layout.querySelector<HTMLElement>("[data-avatar-clock]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const listeners = new AbortController();
    const animations = new Map<HTMLElement, Animation>();
    let previousMode = "";
    let previousPositions: { x: number; y: number }[] = [];
    let previousWidth = 0;
    let previousScrollTop = 0;

    const update = () => {
      if (!dialog.open || dialog.hasAttribute("data-closing")) return;

      const styles = getComputedStyle(layout);
      const mode = [
        styles.getPropertyValue("--avatar-lightbox-layout-mode"),
        socialSlots?.clientHeight,
        clock ? getComputedStyle(clock).gridTemplateColumns.split(" ").length : 0,
      ].join(":");
      const layoutTop = layout.getBoundingClientRect().top;
      const measurements = modules.map(({ element, motionElement }) => {
        const rect = element.getBoundingClientRect();
        const translate = animations.has(element) ? getComputedStyle(element).translate : "none";
        const [offsetX = 0, offsetY = 0] = translate === "none" ? [] : translate.split(" ").map(parseFloat);
        const transform = motionElement ? getComputedStyle(motionElement).transform : "none";
        const entranceY = transform === "none" ? 0 : new DOMMatrixReadOnly(transform).m42;
        // Keep the staggered entrance and scroll position out of the responsive layout measurements.
        return { x: rect.left - offsetX, y: rect.top - layoutTop - offsetY - entranceY, offsetX, offsetY };
      });
      const reflowed = previousMode !== "" && previousMode !== mode;
      const from = previousPositions;
      const scrollOffset = dialog.scrollTop - previousScrollTop;
      previousMode = mode;
      previousPositions = measurements;
      previousWidth = innerWidth;
      previousScrollTop = dialog.scrollTop;
      if (!reflowed || reduced.matches) return;

      const duration = cssTimeToMilliseconds(styles.getPropertyValue("--duration-fast"));
      const easing = styles.getPropertyValue("--ease-smooth-out").trim();
      modules.forEach(({ element }, index) => {
        const { x, y, offsetX, offsetY } = measurements[index];
        const dx = from[index].x + offsetX - x;
        const dy = from[index].y + offsetY - y + scrollOffset;
        animations.get(element)?.cancel();
        animations.delete(element);
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;

        const animation = element.animate([{ translate: `${dx}px ${dy}px` }, { translate: "0px 0px" }], {
          duration, easing, fill: "backwards",
        });
        animations.set(element, animation);
        animation.addEventListener("finish", () => {
          if (animations.get(element) === animation) animations.delete(element);
        }, { once: true });
      });
    };

    const observer = new ResizeObserver(update);
    const stop = () => {
      observer.disconnect();
      animations.forEach((animation) => animation.cancel());
      animations.clear();
      previousMode = "";
      previousPositions = [];
    };
    const start = () => {
      stop();
      if (!dialog.open || reduced.matches) return;
      update();
      observer.observe(dialog);
    };

    dialog.addEventListener("close", () => { if (!dialog.open) stop(); }, { signal: listeners.signal });
    dialog.addEventListener("scroll", () => {
      // A resize can clamp the scroll position before the observer measures the new layout.
      if (dialog.open && innerWidth === previousWidth) previousScrollTop = dialog.scrollTop;
    }, { passive: true, signal: listeners.signal });
    reduced.addEventListener("change", start, { signal: listeners.signal });
    document.addEventListener("astro:before-swap", () => {
      stop();
      listeners.abort();
    }, { once: true, signal: listeners.signal });

    return start;
  }

  async function refreshAvatarPresence(dialog: HTMLDialogElement, signal: AbortSignal) {
    const presence = dialog.querySelector<HTMLElement>("[data-avatar-presence]");
    const offline = presence?.querySelector<HTMLElement>("[data-presence-offline]");
    const online = presence?.querySelector<HTMLElement>("[data-presence-online]");
    if (!presence || !offline || !online) return;

    try {
      const response = await fetch("/api/presence", { cache: "no-store", signal });
      if (!response.ok) return;
      const data: { status?: unknown } | null = await response.json();
      const status = data?.status;
      if (signal.aborted || (status !== "online" && status !== "offline")) return;
      if (presence.dataset.avatarPresence === status) return;

      presence.dataset.avatarPresence = status;
      offline.hidden = status === "online";
      online.hidden = status === "offline";
    } catch {
      // Keep the last displayed state if the request fails or the dialog closes.
    }
  }

  function bindAvatarLightboxes() {
    document.querySelectorAll<HTMLDialogElement>("[data-avatar-lightbox]").forEach((dialog) => {
      if (initialized.has(dialog)) return;
      initialized.add(dialog);
      const refreshClock = bindAvatarClock(dialog);
      const stopPortrait = bindAvatarPortrait(dialog);
      const refreshFitness = bindAvatarFitness(dialog);
      const refreshActivity = bindAvatarActivity(dialog);
      const activity = dialog.querySelector<HTMLElement>("[data-avatar-activity]");
      const layout = dialog.querySelector<HTMLElement>("[data-avatar-layout]");
      const startLayoutMotion = bindAvatarLayoutMotion(dialog, layout);
      let dataRequest: AbortController | undefined;

      const requestClose = () => {
        if (!dialog.open || dialog.hasAttribute("data-closing")) return;
        dataRequest?.abort();
        stopPortrait?.();
        dialog.setAttribute("data-closing", "");

        const finishClose = () => {
          dialog.close();
          dialog.removeAttribute("data-closing");
        };
        const transitions = dialog.getAnimations({ subtree: true })
          .filter((animation) => animation instanceof CSSTransition);
        if (transitions.length === 0) {
          finishClose();
          return;
        }
        void Promise.allSettled(transitions.map((transition) => transition.finished)).then(finishClose);
      };

      document.querySelectorAll<HTMLButtonElement>(
        `[data-avatar-lightbox-trigger][aria-controls="${CSS.escape(dialog.id)}"]`,
      ).forEach((trigger) => {
        trigger.addEventListener("click", () => {
          if (dialog.open) return;
          trigger.focus({ preventScroll: true });
          dialog.showModal();
          dialog.scrollTop = 0;
          if (activity) activity.scrollTop = 0;
          refreshClock?.();
          dataRequest?.abort();
          dataRequest = new AbortController();
          void refreshAvatarPresence(dialog, dataRequest.signal);
          void refreshFitness?.(dataRequest.signal);
          void refreshActivity?.(dataRequest.signal);
          startLayoutMotion?.();
        });
      });

      let pressedBackdrop = false;
      dialog.addEventListener("pointerdown", (event) => { pressedBackdrop = event.target === dialog; });
      dialog.addEventListener("click", (event) => {
        if (pressedBackdrop && event.target === dialog) requestClose();
      });
      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        requestClose();
      });
      dialog.addEventListener("submit", (event) => {
        event.preventDefault();
        requestClose();
      });
    });
  }

  bindAvatarLightboxes();
  document.addEventListener("astro:page-load", bindAvatarLightboxes);
</script>

<style>
  :global(html:has(.avatar-lightbox[open])) { overflow: hidden; }

  .avatar-lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-color: var(--color-avatar-lightbox-caption) var(--color-avatar-lightbox-surface);
    border: 0;
    background: transparent;
    color: var(--color-avatar-lightbox-caption);
    color-scheme: dark;
    cursor: pointer;
    font-size: var(--text-body);
    line-height: var(--space-5);
  }

  .avatar-lightbox::backdrop {
    background: color-mix(in srgb, var(--primitive-color-warm-925) var(--avatar-lightbox-backdrop-opacity), transparent);
    backdrop-filter: blur(var(--space-5));
  }

  .avatar-lightbox__dismiss {
    --avatar-lightbox-close-inset: calc(var(--space-1) + 1px);
    position: fixed;
    z-index: 1;
    inset: auto 0 0;
    display: grid;
    justify-items: center;
    padding-block-end: calc(var(--space-8) + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }

  .avatar-lightbox__dismiss :global(.avatar-lightbox__dismiss-backdrop) {
    --progressive-blur-height: var(--dock-backdrop-height);
    --progressive-blur-color: var(--primitive-color-warm-925);
  }

  .avatar-lightbox__dismiss :global(.avatar-lightbox__close) {
    --avatar-lightbox-close-highlight: 0;
    position: relative;
    isolation: isolate;
    width: 11rem;
    max-width: 100%;
    min-height: calc(var(--space-12) + var(--space-1) / 2);
    border: 0;
    border-radius: var(--radius-lg);
    color: var(--color-avatar-lightbox-caption);
    font: var(--weight-regular) var(--text-body)/var(--space-5) "PingFang SC", var(--font-sans);
    pointer-events: auto;
  }

  @media (width < 720px) {
    .avatar-lightbox__dismiss :global(.avatar-lightbox__close) {
      --avatar-lightbox-close-highlight: 1;
    }
  }

  .avatar-lightbox__dismiss :global(.avatar-lightbox__close:focus-visible) {
    --avatar-lightbox-close-highlight: 1;
    color: var(--color-avatar-lightbox-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .avatar-lightbox__dismiss :global(.avatar-lightbox__close:hover) {
      --avatar-lightbox-close-highlight: 1;
      color: var(--color-avatar-lightbox-text);
    }
  }

  .avatar-lightbox__dismiss :global(.avatar-lightbox__close)::before,
  .avatar-lightbox__dismiss :global(.avatar-lightbox__close)::after {
    position: absolute;
    border: 1px solid var(--color-avatar-lightbox-line);
    content: "";
  }

  .avatar-lightbox__dismiss :global(.avatar-lightbox__close)::before {
    z-index: -2;
    inset: 0;
    border-radius: var(--radius-lg);
    background: var(--color-avatar-lightbox-frame);
    opacity: var(--avatar-lightbox-close-highlight);
    transform: scale(calc(.96 + .04 * var(--avatar-lightbox-close-highlight)));
  }

  .avatar-lightbox__dismiss :global(.avatar-lightbox__close)::after {
    z-index: -1;
    inset: var(--avatar-lightbox-close-inset) var(--space-1);
    border-radius: var(--radius-md);
    background: var(--color-avatar-lightbox-surface);
    transform: scaleX(calc(1 - var(--avatar-lightbox-close-highlight) / 84));
  }

  .avatar-lightbox__close-hint { display: none; }

  .avatar-lightbox__layout {
    --avatar-lightbox-layout-mode: narrow;
    display: grid;
    max-width: 90rem;
    margin-inline: auto;
    padding: calc(var(--space-16) + env(safe-area-inset-top, 0px))
      max(var(--space-4), env(safe-area-inset-right, 0px))
      var(--dock-reserve)
      max(var(--space-4), env(safe-area-inset-left, 0px));
    gap: var(--space-6);
    pointer-events: none;
  }

  .avatar-lightbox__layout :global(.avatar-lightbox__card),
  .avatar-lightbox__location {
    pointer-events: auto;
    cursor: default;
  }

  .avatar-lightbox__overview,
  .avatar-lightbox__intro,
  .avatar-lightbox__status {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    min-width: 0;
  }

  .avatar-lightbox__intro {
    --avatar-lightbox-portrait-width: 15rem;
    --avatar-lightbox-intro-gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr) minmax(7rem, .75fr);
    gap: var(--avatar-lightbox-intro-gap);
  }

  .avatar-lightbox__portrait {
    position: relative;
    width: min(100%, var(--avatar-lightbox-portrait-width));
    height: 13.125rem;
  }

  .avatar-lightbox__portrait-art {
