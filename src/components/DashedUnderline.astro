---
import type { HTMLAttributes } from "astro/types";
import PixelPersonPreview from "./PixelPersonPreview.astro";
import PhotoStackGallery from "./PhotoStackGallery.astro";
import type { PhotoStackPhoto } from "../lib/photo-stack-types";

interface Props extends HTMLAttributes<"span"> {
  effect?: "none" | "selection" | "pixel-person" | "wave" | "logos" | "photo-stack" | "flowers";
  logos?: readonly { src: string; alt: string; rotation?: number }[];
  photos?: readonly PhotoStackPhoto[];
}

const { class: className, effect = "none", logos = [], photos = [], ...attributes } = Astro.props;
const hasPhotoStack = effect === "photo-stack" && photos.length === 6 && new Set(photos.map((photo) => photo.id)).size === 6;
const hasEffect = effect !== "none" && effect !== "photo-stack";
const waveId = effect === "wave" ? `wave-${crypto.randomUUID()}` : undefined;
// Separate pen strokes let stems, leaves and petals draw along their own paths.
const flowerPaths = [
  {
    stem: "M34 84 C36 77 30 73 32 66 C33 57 40 46 36 37 L34 33",
    leaf: "M33 65 C36 59 44 53 45 54 C46 57 38 61 34 63",
    petals: "M32 31 C30 22 22 20 19 23 C18 24 21 23 20 24 C13 27 17 35 26 34 L32 32 C34 24 36 17 39 18 C45 19 40 27 35 30 M35 32 C41 29 47 33 50 38 C53 43 44 42 40 38 L35 34 M31 34 C24 34 20 38 21 42 C22 44 29 39 32 36",
    center: "M34 31 C31 29 30 33 33 34 C36 35 36 31 34 31",
  },
  {
    stem: "M32 84 C29 77 35 66 34 57 C34 46 27 40 28 32",
    leaf: "M34 66 C35 59 43 53 44 52 C46 50 43 57 42 57 M41 58 C39 61 36 62 34 64 M33 73 C28 71 22 69 20 65 C25 64 30 67 33 71",
    petals: "M28 29 C21 20 23 11 26 10 L28 11 M30 13 C37 20 33 27 31 29 C37 25 45 25 48 27 C51 30 47 34 44 34 C39 36 33 33 31 32 C31 35 37 38 34 40 C30 44 27 40 27 33 M26 28 C21 23 15 28 14 32 C13 35 15 36 17 35 M20 36 C23 35 25 33 27 31",
    center: "M29 28 C26 29 28 32 30 31 C32 30 30 27 29 28",
  },
  {
    stem: "M34 84 C28 77 33 69 35 60 C40 47 36 43 34 36",
    leaf: "M34 67 C38 62 44 58 46 58 C48 58 43 62 41 63",
    petals: "M29 31 C21 30 14 26 17 22 C19 18 25 17 28 20 M29 22 C32 25 33 29 31 32 C37 30 44 29 48 31 C53 35 45 39 40 39 L34 38 M29 34 C23 36 19 41 21 45 M23 45 C28 46 27 41 32 39",
    center: "M31 33 C28 33 29 37 32 37 C35 37 34 33 31 33",
  },
];
---

{hasPhotoStack ? <PhotoStackGallery photos={photos} class={className} {...attributes}><span class="dashed-underline dashed-underline--photo-stack"><slot /></span></PhotoStackGallery> : (<span class:list={["dashed-underline", { "dashed-underline--interactive": hasEffect, "dashed-underline--selection": effect === "selection", "dashed-underline--pixel-person": effect === "pixel-person", "dashed-underline--wave": effect === "wave", "dashed-underline--logos": effect === "logos", "dashed-underline--flowers": effect === "flowers" }, className]} tabindex={hasEffect ? 0 : undefined} {...attributes}><slot />{effect === "selection" && <span class="dashed-underline__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>}{effect === "pixel-person" && <PixelPersonPreview />}{effect === "logos" && <span class="dashed-underline__logos" aria-hidden="true">
    {logos.slice(0, 3).map((logo, index) => <img src={logo.src} alt={logo.alt} width="40" height="40" decoding="async" draggable="false" style={`--logo-index: ${index}; --logo-image-rotation: ${logo.rotation ?? 0}deg`} />)}
  </span>}{effect === "flowers" && <span class="dashed-underline__flowers" aria-hidden="true">
    {flowerPaths.map((flower, index) => <svg class="dashed-underline__flower" style={`--flower-index: ${index}`} viewBox="0 0 60 90" fill="none" focusable="false">
      {Object.entries(flower).flatMap(([part, d]) => {
        const strokes = d.split(/(?=M)/).filter(Boolean);
        return strokes.map((stroke, strokeIndex) => <path class:list={["dashed-underline__flower-stroke", `dashed-underline__flower-stroke--${part}`]} style={`--flower-stroke-count: ${strokes.length}; --flower-stroke-index: ${strokeIndex}`} d={stroke} pathLength="1" />);
      })}
    </svg>)}
  </span>}{effect === "wave" && <span class="dashed-underline__wave" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" focusable="false">
      <defs><pattern id={waveId} width="12" height="8" patternUnits="userSpaceOnUse"><path d="M0 4 Q3 0 6 4 T12 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></pattern></defs>
      <rect width="100%" height="100%" fill={`url(#${waveId})`} />
    </svg>
  </span>}</span>
)}

<style>
  .dashed-underline {
    color: var(--color-link);
    text-decoration-line: underline;
    text-decoration-style: dashed;
    text-decoration-color: var(--color-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: var(--space-1);
    text-decoration-skip-ink: none;
  }

  .dashed-underline--interactive,
  .dashed-underline--photo-stack {
    text-decoration-line: none;
  }

  .dashed-underline--interactive {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    cursor: var(--cursor-figma);
    transition: none;
  }

  .dashed-underline--interactive::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--space-1) / 2) calc(-1 * (var(--selection-frame-padding-inline) + var(--selection-handle-size) / 2));
    cursor: inherit;
  }

  .dashed-underline__frame {
    position: absolute;
    inset: var(--selection-frame-inset-block) calc(-1 * var(--selection-frame-padding-inline));
    opacity: 0;
    pointer-events: none;
    transition: none;
  }

  .dashed-underline__frame::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-selection-frame);
  }

  .dashed-underline__frame i {
    position: absolute;
    width: var(--selection-handle-size);
    height: var(--selection-handle-size);
    border: 1px solid var(--color-selection-frame);
    background: var(--color-selection-handle);
    transform: translate(-50%, -50%);
  }
  .dashed-underline__frame i:nth-child(1) { top: 0; left: 0; }
  .dashed-underline__frame i:nth-child(2) { top: 0; left: 100%; }
  .dashed-underline__frame i:nth-child(3) { top: 100%; left: 0; }
  .dashed-underline__frame i:nth-child(4) { top: 100%; left: 100%; }

  .dashed-underline--selection:focus-visible {
    text-decoration-color: transparent;
    outline: none;
  }

  .dashed-underline--selection:focus-visible .dashed-underline__frame {
    opacity: 1;
  }

  .dashed-underline__wave {
    position: absolute;
    top: calc(50% + .5em);
    left: 0;
    width: 100%;
    height: var(--wave-underline-height);
    overflow: hidden;
    color: var(--color-wave-underline);
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
    transition: opacity var(--duration-quick) var(--ease-smooth-out), clip-path var(--duration-quick) var(--ease-smooth-out), visibility 0s var(--duration-quick);
  }

  .dashed-underline__wave svg {
    display: block;
    width: calc(100% + var(--wave-underline-period));
    height: 100%;
    animation: underline-wave var(--duration-wave-underline) linear infinite;
    animation-play-state: paused;
  }

  .dashed-underline--wave:focus-visible {
    text-decoration-color: transparent;
  }

  .dashed-underline--wave:focus-visible .dashed-underline__wave {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0);
    transition: none;
  }

  @keyframes underline-wave {
    to { transform: translateX(calc(-1 * var(--wave-underline-period))); }
  }

  .dashed-underline__logos {
    position: absolute;
    z-index: 1;
    bottom: calc(100% - var(--space-1));
    left: 50%;
    width: var(--logo-preview-size);
    height: var(--logo-preview-size);
    transform: translateX(-50%);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s var(--duration-quick);
  }

  .dashed-underline__logos img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(var(--shadow-logo-preview));
    opacity: 0;
    transform: translateY(var(--logo-preview-travel)) scale(.45) rotate(var(--logo-image-rotation));
    transition: transform var(--duration-quick) var(--ease-smooth-out), opacity var(--duration-quick) var(--ease-smooth-out);
  }

  .dashed-underline__logos img:nth-child(2) { --logo-lift: calc(-1 * var(--space-1)); z-index: 1; }

  .dashed-underline--flowers::before {
    inset-block: calc(-1 * var(--space-3));
  }

  .dashed-underline__flowers {
    position: absolute;
    z-index: 1;
    bottom: calc(100% - var(--space-1));
    left: 50%;
    width: calc(var(--garden-flower-width) + var(--garden-flower-spread) * 2);
    height: calc(var(--garden-flower-height) + var(--space-3));
    transform: translateX(-50%);
    pointer-events: none;
  }

  .dashed-underline__flower {
    position: absolute;
    bottom: 0;
    left: calc(var(--flower-index) * var(--garden-flower-spread));
    width: var(--garden-flower-width);
    height: var(--garden-flower-height);
    transform-origin: 50% 96%;
    transform: rotate(calc((var(--flower-index) - 1) * var(--garden-flower-rotation)));
  }

  .dashed-underline__flower:nth-child(2) {
    width: calc(var(--garden-flower-width) + var(--space-2));
    height: calc(var(--garden-flower-height) + var(--space-3));
    transform: scaleX(-1);
  }

  .dashed-underline__flower-stroke {
    stroke: var(--color-copy);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    visibility: hidden;
    transition: stroke-dashoffset var(--duration-fast) var(--ease-garden-grow), visibility 0s var(--duration-fast);
  }

  .dashed-underline__flower-stroke--stem {
    --flower-stroke-duration: var(--duration-garden-stem);
    --flower-stroke-start: 0ms;
  }

  .dashed-underline__flower-stroke--leaf {
    --flower-stroke-duration: var(--duration-garden-leaf);
    --flower-stroke-start: var(--delay-garden-leaf);
  }

  .dashed-underline__flower-stroke--petals {
    --flower-stroke-duration: var(--duration-garden-petals);
    --flower-stroke-start: var(--duration-garden-stem);
  }

  .dashed-underline__flower-stroke--center {
    --flower-stroke-duration: var(--duration-garden-center);
    --flower-stroke-start: calc(var(--duration-garden-stem) + var(--duration-garden-petals));
  }

  .dashed-underline--flowers:is(:hover, :focus) .dashed-underline__flower-stroke {
    stroke-dashoffset: 0;
    visibility: visible;
    transition-duration: calc(var(--flower-stroke-duration) / var(--flower-stroke-count)), 0s;
    transition-delay: calc(var(--flower-index) * var(--delay-garden-flower) + var(--flower-stroke-start) + var(--flower-stroke-index) * var(--flower-stroke-duration) / var(--flower-stroke-count));
  }

  .dashed-underline--logos:focus-visible .dashed-underline__logos {
    visibility: visible;
    transition-delay: 0s;
  }

  .dashed-underline--logos:focus-visible .dashed-underline__logos img {
    opacity: 1;
    transform: translate(calc((var(--logo-index) - 1) * var(--logo-preview-spread)), var(--logo-lift, 0px)) rotate(calc((var(--logo-index) - 1) * var(--logo-preview-rotation) + var(--logo-image-rotation)));
    transition-duration: var(--duration-project-attribute);
    transition-delay: calc(var(--logo-index) * var(--delay-logo-preview));
  }

  @media (hover: hover) and (pointer: fine) {
    .dashed-underline--selection:hover { text-decoration-color: transparent; }
    .dashed-underline--selection:hover .dashed-underline__frame {
      opacity: 1;
    }
    .dashed-underline--wave:hover { text-decoration-color: transparent; }
    .dashed-underline--wave:hover .dashed-underline__wave {
      visibility: visible;
      opacity: 1;
      clip-path: inset(0);
      transition-duration: var(--duration-fast), var(--duration-fast), 0s;
      transition-delay: 0s;
    }
    .dashed-underline--wave:hover .dashed-underline__wave svg {
      animation-play-state: running;
    }
    .dashed-underline--logos:hover .dashed-underline__logos {
      visibility: visible;
      transition-delay: 0s;
    }
    .dashed-underline--logos:hover .dashed-underline__logos img {
      opacity: 1;
      transform: translate(calc((var(--logo-index) - 1) * var(--logo-preview-spread)), var(--logo-lift, 0px)) rotate(calc((var(--logo-index) - 1) * var(--logo-preview-rotation) + var(--logo-image-rotation)));
      transition-duration: var(--duration-project-attribute);
      transition-delay: calc(var(--logo-index) * var(--delay-logo-preview));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dashed-underline--wave .dashed-underline__wave { transition: none !important; }
    .dashed-underline--wave .dashed-underline__wave svg { animation: none !important; }
    .dashed-underline__logos, .dashed-underline__logos img { transition: none !important; }
    .dashed-underline__flower-stroke { transition: none !important; }
  }

</style>
