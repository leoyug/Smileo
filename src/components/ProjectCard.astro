---
import { mediaUrl } from "../lib/media-url";
import TextLink from "./TextLink.astro";
import { projectStatuses } from "../lib/project-status";
import { projectBadgeVariants, type ProjectBadgeVariant } from "../lib/project-badges";

interface Props {
  title: string;
  summary: string;
  year?: string | number;
  status?: keyof typeof projectStatuses;
  href?: string;
  image?: string;
  badge?: ProjectBadgeVariant;
}
const { title, summary, year, status, href = "/projects", image, badge } = Astro.props;
const label = status ? projectStatuses[status].label : undefined;
const badgeContent = badge ? projectBadgeVariants[badge] : undefined;
const linkLabel = ["查看项目", title, badgeContent?.label, label, year].filter(Boolean).join("，");
---

<article class="project-card" data-list-sound>
  <a class="project-card__shot" href={href} aria-label={linkLabel}>
    <span class="project-card__visual">
      {badgeContent && <span class="project-card__attribute" data-project-badge={badge} aria-hidden="true"><img class="project-card__attribute-icon" src={badgeContent.icon} width="16" height="16" alt="" /><span>{badgeContent.label}</span></span>}
      <span class="project-card__media">
        {image ? <img src={mediaUrl(image)} alt="" loading="lazy" /> : (
          <span class="project-card__preview">
            <span class="project-card__chrome"></span>
            <span class="project-card__screen">
              <span class="project-card__document"></span>
              <span class="project-card__sidebar"></span>
            </span>
          </span>
        )}
      </span>
    </span>
  </a>
  <div class="project-card__body">
    <div class="project-card__heading"><h3><TextLink href={href} underline="reveal">{title}</TextLink></h3></div>
    <p>{summary}</p>
  </div>
</article>
