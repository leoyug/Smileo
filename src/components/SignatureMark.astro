---
import type { HTMLAttributes } from "astro/types";
import "../styles/signature-write.css";

interface Props extends HTMLAttributes<"svg"> {
  label?: string;
}

const { class: className, label = "Leo", ...attributes } = Astro.props;
const filterId = `signature-ink-${crypto.randomUUID()}`;
---

<svg
  class:list={["signature-mark", className]}
  width="64"
  height="48"
  viewBox="0 0 128 96"
  fill="none"
  stroke="currentColor"
  stroke-width="4.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
  data-signature-mark
  {...attributes}
>
  <defs>
    <filter id={filterId} x="0" y="0" width="128" height="96" filterUnits="userSpaceOnUse" primitiveUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.65 0.8" numOctaves="3" seed="4" result="grain" />
      <feDisplacementMap in="SourceGraphic" in2="grain" scale="1.25" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
  <g filter={`url(#${filterId})`}>
    <path class="signature-mark__stroke" pathLength="1" d="M22 12.8 C18.8 21.2 16.1 34.4 14.5 45.2 C13.2 54.1 11 61.1 11.4 67.4 C11.9 73.8 14.8 79.7 19.8 81.5 C28.8 84.3 37.8 75.7 45.3 67.5 C50.3 62.2 55.3 55.5 59.4 52.4 C60.6 50.8 62 49 63.2 47.3 C66.4 42.6 66.4 37.7 62.8 41 C59.1 44.7 57.9 49.1 59.4 52.4 C61.8 58.9 68 59.2 71.9 56.7 C74.5 55.9 78.1 52.3 82 51.7 C85 51 87.1 52.7 91.3 50.7 C96.8 48.2 100.7 45.2 106.2 40.8 C112 36.1 119.3 32.4 116.6 28.5 C113.7 24.2 105.9 26 101.1 27.8" />
  </g>
</svg>

<style>
  .signature-mark {
    display: block;
    color: var(--color-signature);
  }

  .signature-mark__stroke {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 0;
    animation: leo-signature-write var(--duration-signature-write) linear var(--delay-signature-write) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-mark__stroke { animation: none; }
  }
</style>
