---
import { projectCaseSlotLink, renderProjectCaseBody } from "../../lib/project-case-slots";

const source = await Astro.slots.render("default") ?? "";
const slots = new Map<string, string>();
for (const [, name] of source.matchAll(projectCaseSlotLink)) {
  const media = await Astro.slots.render(name);
  if (media == null) throw new Error(`Missing project case slot: ${name}`);
  slots.set(name, media);
}
---

<div class="article__body" id="content" data-route-enter-body set:html={renderProjectCaseBody(source, slots)} />

<style>
  .article__body > :global(.project-case-label) {
    margin-block-end: var(--space-2);
  }

  :global(html:not(:lang(en))) .article__body > :global(.project-case-label) {
    color: var(--color-faint);
    font-family: var(--font-sans);
    font-size: .6875rem;
    font-weight: var(--weight-medium);
    line-height: var(--space-4);
    letter-spacing: .05em;
  }

  :global([data-project-id="zhaichangxiang-website"]) .article__body > :global(.project-case-label),
  .article__body > :global(.project-case-label:has(+ h2 + .app-goals__copy)) {
    margin-block-end: var(--space-3);
  }

  .article__body > :global(:is(.app-goals__copy, .project-case-label:has(+ h2 + .app-goals__copy)):lang(zh)) {
    font-family: "PingFang SC", var(--font-sans);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-body);
  }

  .article__body > :global(.project-case-label:lang(zh):has(+ h2 + .app-goals__copy)) {
    font-size: var(--text-meta);
    line-height: 1.125rem;
  }

  .article__body > :global(.project-case-label:first-child),
  .article__body > :global(.project-case-label + h2) {
    margin-block-start: 0;
  }

  .article__body > :global(p > strong:first-child),
  .article__body > :global(.app-goals__copy > p > strong:first-child) {
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
  }

  .article__body > :global(.app-goals__copy b) {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
  }

  :global([data-project-id="Zhaichangxiang-App"]) .article__body > :global(h3) {
    margin-block-end: var(--space-3);
    color: var(--color-ink);
    font: var(--weight-semibold) var(--text-body)/var(--space-5) "PingFang SC", var(--font-sans);
  }

  :global([data-project-id="Zhaichangxiang-App"]) .article__body > :global(h3 + p) {
    margin-block-start: var(--space-3);
  }

  :global([data-project-id="Zhaichangxiang-App"]) .article__body > :global(p b) {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
  }

  :global([data-project-id="Zhaichangxiang-App"]) .article__body > :global(.project-case-label:lang(zh):has(+ h2 + h3)) {
    margin-block-end: var(--space-3);
    font-weight: var(--weight-regular);
    font-size: var(--text-meta);
    line-height: 1.125rem;
    letter-spacing: var(--tracking-body);
  }

  :global([data-project-id="Zhaichangxiang-App"]) .article__body > :global(.project-case-label:has(~ [data-case-slot="app-reflection"]):not(:has(~ [data-case-slot="app-business"]))) {
    margin-block-end: var(--space-3);
  }
</style>
