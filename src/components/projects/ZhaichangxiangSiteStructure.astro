---
import Card from "../Card.astro";
import "./ZhaichangxiangSiteStructure.css";

interface Props {
  id: string;
}

const { id } = Astro.props;
const stages = [
  { title: "首屏定位", description: "用核心卖点、设备效果图和平台数据建立产品认知。", shapes: ["hero"] },
  { title: "获客链路", description: "用漏斗呈现家装业务的成交链路，说明产品从哪里介入。", shapes: ["heading", "funnel"] },
  { title: "解决方案与功能", description: "按业务阶段展示解决方案，再用核心技术和产品界面说明能力。", shapes: ["heading", "feature"] },
  { title: "信任依据", description: "用客户案例、合作伙伴和数据回应使用顾虑。", shapes: ["heading", "cases"] },
  { title: "体验与咨询", description: "在底部集中提供免费试用和咨询入口。", shapes: ["action"] },
];
---

<figure class="site-structure">
  <Card variant="quiet" class="site-structure__panel">
    <div class="site-structure__layout" role="radiogroup" aria-labelledby={`${id}-caption`}>
      <div class="site-structure__browser" aria-hidden="true">
        <div class="site-structure__toolbar">
          <img src="/assets/figma/zhaichangxiang-website/browser-controls.svg" alt="" width="64" height="16" />
          <span class="site-structure__address"></span>
        </div>
      </div>
      <ol class="site-structure__stages" role="list">
        {stages.map(({ title, description, shapes }, index) => {
          const stageId = `${id}-${index + 1}`;

          return (
            <li class="site-structure__row">
              <label class="site-structure__choice">
                <input
                  class="sr-only"
                  type="radio"
                  id={stageId}
                  name={id}
                  checked={index === 0}
                  aria-labelledby={`${stageId}-title`}
                  aria-describedby={`${stageId}-description`}
                />
                <span class="site-structure__heading">
                  <strong id={`${stageId}-title`}>{title}</strong>
                  <span class="site-structure__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                </span>
                <span id={`${stageId}-description`}>{description}</span>
              </label>
              <label class="site-structure__wireframe" for={stageId} aria-hidden="true">
                {shapes.map(shape => shape === "cases" ? (
                  <span class="site-structure__cases">
                    <span class="site-structure__shape"></span>
                    <span class="site-structure__shape"></span>
                    <span class="site-structure__shape"></span>
                  </span>
                ) : (
                  <span class="site-structure__shape" data-shape={shape}></span>
                ))}
              </label>
            </li>
          );
        })}
      </ol>
    </div>
  </Card>
  <figcaption id={`${id}-caption`}>官网首页结构</figcaption>
</figure>
