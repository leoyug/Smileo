---
import Card from "../../Card.astro";

const assets = "/assets/figma/zhaichangxiang-app";
const categories = [
  { title: "家装平台类产品", products: [["土巴兔", "tubatu"], ["百安居", "b-and-q"], ["一兜糖", "yidoutang"]] },
  { title: "家装设计类产品", products: [["酷家乐", "kujiale"], ["居然", "easyhome"], ["知户型", "zhihuxing"]] },
  { title: "其他家装服务类产品", products: [["链家", "lianjia"], ["躺平", "tangping"], ["造作", "zaozuo"]] },
];
const comparisons = [
  {
    title: "首页布局", icon: "home",
    findings: [
      ["明显入口", "在首屏提供明显的「新建方案」入口。"],
      ["品牌传递", "使用品牌主色和标志，加强品牌印象。"],
      ["信任传递", "保留服务说明、案例等信任信息。"],
      ["形成决策", "生成短链供客户预览。"],
    ],
  },
  {
    title: "创建流程", icon: "create",
    findings: [
      ["多种导入方式", "按用户需求精确建立户型或快速生成。"],
      ["明确的进度指示", "说明当前步骤、出图时间和异常处理方式。"],
      ["减少决策时间", "确定户型后触发 AI 建模并展示可交互预览。"],
      ["快速分享", "一键分享效果图或链接，支持小程序预览。"],
    ],
  },
  {
    title: "装修编辑", icon: "editor",
    findings: [
      ["AI 快速建模", "确定户型后快速生成可编辑模型。"],
      ["实时预览", "提供实时渲染并快速生成效果图。"],
      ["智能推荐", "快速生成可供用户选择的装修方案。"],
      ["精确调整参数", "支持精确尺寸输入与版本管理。"],
    ],
  },
];
---

<div class="app-comparison">
  <div class="app-comparison__grid app-comparison__categories" role="group" aria-label="竞品类别">
    {categories.map(({ title, products }) => (
      <Card class="app-comparison__category">
        <strong>{title}</strong>
        <ul class="app-comparison__products" role="list">
          {products.map(([name, asset]) => (
            <li>
              <span>{name}</span>
              <img src={`${assets}/logo-${asset}.webp`} alt="" width="40" height="40" loading="lazy" />
            </li>
          ))}
        </ul>
      </Card>
    ))}
  </div>
  <img class="app-comparison__arrow" src={`${assets}/comparison-arrow.svg`} alt="" loading="lazy" />
  <div class="app-comparison__grid" role="group" aria-label="竞品分析维度">
    {comparisons.map(({ title, icon, findings }) => (
      <Card class="app-comparison__dimension">
        <div class="app-comparison__title">
          <span
            class="app-comparison__icon"
            style={{ "--comparison-icon": `url(${assets}/comparison-${icon}.svg)` }}
            aria-hidden="true"
          ></span>
          <strong>{title}</strong>
        </div>
        <dl class="app-comparison__findings">
          {findings.map(([label, copy]) => <div><dt>{label}</dt><dd>{copy}</dd></div>)}
        </dl>
      </Card>
    ))}
  </div>
</div>

<style>
  .app-comparison {
    display: grid;
    gap: var(--space-8);
    color: var(--color-ink);
    container-type: inline-size;
  }

  .app-comparison__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .app-comparison :global(.app-comparison__category),
  .app-comparison :global(.app-comparison__dimension) {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4) var(--space-5) var(--space-5);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-project-case-surface);
  }

  .app-comparison :global(.app-comparison__category) {
    align-content: space-between;
  }

  .app-comparison strong {
    font-weight: var(--weight-medium);
    line-height: var(--space-5);
  }

  .app-comparison .app-comparison__products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .app-comparison__products li {
    display: grid;
    align-content: end;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    color: var(--color-copy);
    font-size: var(--text-meta);
    line-height: var(--space-4);
    overflow-wrap: anywhere;
  }

  .app-comparison__products img {
    display: block;
    width: 2.5rem;
    max-width: 100%;
    height: auto;
    margin: 0;
    border-radius: calc(var(--radius-sm) + var(--space-1) / 2);
  }

  .app-comparison__categories:lang(en) {
    grid-template-columns: minmax(0, 1fr);
  }

  .app-comparison__categories:lang(en) > :global(.app-comparison__category) {
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .app-comparison .app-comparison__products:lang(en) {
    display: flex;
    flex-wrap: wrap;
  }

  .app-comparison__products:lang(en) li {
    justify-items: center;
    flex: 1 0 var(--space-16);
    min-inline-size: max-content;
  }

  .app-comparison__products:lang(en) img {
    order: -1;
  }

  .app-comparison__products:lang(en) li > span {
    white-space: nowrap;
  }

  @container (min-width: 35rem) {
    .app-comparison__categories:lang(en) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .app-comparison .app-comparison__products:lang(en) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .app-comparison__products:lang(en) li {
      grid-template-columns: var(--space-8) minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      min-inline-size: 0;
    }

    .app-comparison__products:lang(en) img {
      width: var(--space-8);
      border-radius: var(--radius-sm);
    }
  }

  .app-comparison__arrow {
    display: block;
    justify-self: center;
    transform: rotate(-90deg);
  }

  .app-comparison :global(.app-comparison__dimension) {
    gap: 0;
    padding: 0;
    overflow-wrap: anywhere;
  }

  .app-comparison__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4);
    border-bottom: .5px solid light-dark(var(--color-line), var(--color-line-subtle));
  }

  .app-comparison__icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    border-radius: calc(var(--radius-md) / 2);
    background: light-dark(var(--color-line), var(--color-surface-2));
  }

  .app-comparison__icon::before {
    content: "";
    inline-size: var(--space-4);
    block-size: var(--space-4);
    background: currentColor;
    mask: var(--comparison-icon) center / contain no-repeat;
  }

  .app-comparison__title strong {
    min-width: 0;
    font-size: var(--text-title);
    font-weight: var(--weight-semibold);
  }

  .app-comparison__findings {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-4);
    font-size: var(--text-meta);
  }

  .app-comparison__findings dt {
    color: var(--color-project-case-finding-title);
    font-weight: var(--weight-medium);
    line-height: var(--space-4);
  }

  .app-comparison__findings dd {
    margin: var(--space-1) 0 0;
    color: light-dark(var(--color-copy), var(--color-faint));
    line-height: var(--space-5);
  }

  @container (max-width: 32rem) {
    .app-comparison__grid { grid-template-columns: minmax(0, 1fr); }
    .app-comparison .app-comparison__products { grid-template-columns: repeat(3, minmax(0, 4rem)); }
  }
</style>
