---
import { languagePath } from "../i18n/runtime";
import { mediaUrl } from "../lib/media-url";
import { siteDescription, siteTitles } from "../lib/site-metadata";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/site.css";
import "../styles/site-responsive.css";

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  wide?: boolean;
  socialImage?: string | null;
  robots?: string;
  showNavigation?: boolean;
}

const {
  title,
  titleEn = title,
  description = siteDescription,
  wide = false,
  socialImage = "/og-ian-inspired.png",
  robots,
  showNavigation = true,
} = Astro.props;
const localizedTitles = {
  "zh-CN": title ? `${title}｜${siteTitles["zh-CN"]}` : siteTitles["zh-CN"],
  en: titleEn ? `${titleEn}｜${siteTitles.en}` : siteTitles.en,
};
const canonical = new URL(Astro.url.pathname, Astro.site);
const resolvedSocialImage = socialImage ? new URL(mediaUrl(socialImage), Astro.site) : null;
const isDetailRoute = /^\/(?:projects|writing)\/[^/]+\/?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#fbfaf9" />
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem("incessant-theme");
        const themePreference = storedTheme === "dark" || storedTheme === "light" ? storedTheme : "system";
        document.documentElement.dataset.themePreference = themePreference;
        document.documentElement.dataset.theme = themePreference === "system" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : themePreference;
        if (location.pathname === "/" && localStorage.getItem("incessant-language") === "en") location.replace(`/en/${location.search}${location.hash}`);
      } catch {
        document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
    </script>
    <link rel="icon" href="/favicon.svg?v=f9fb16d0d39c" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon-leo.png?v=f9fb16d0d39c" />
    <link rel="canonical" href={canonical} />
    {!Astro.url.pathname.startsWith('/design-system') && <>
      <link rel="alternate" hreflang="zh-CN" href={canonical} />
      <link rel="alternate" hreflang="en" href={new URL(languagePath(Astro.url.pathname, 'en'), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={canonical} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteTitles["zh-CN"]} />
    <meta property="og:title" content={localizedTitles["zh-CN"]} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta property="og:image:width" content="1536" />}
    {resolvedSocialImage && <meta property="og:image:height" content="1024" />}
    <meta name="twitter:card" content={resolvedSocialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={localizedTitles["zh-CN"]} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="animate" />
    <title data-title-zh={localizedTitles["zh-CN"]} data-title-en={localizedTitles.en}>{localizedTitles["zh-CN"]}</title>
    <script>
      import "../scripts/site-title";
    </script>
  </head>
  <body class:list={{ "body--detail-route": isDetailRoute, "body--no-dock": !showNavigation }}>
    {isDetailRoute && <div class="detail-route-backdrop" aria-hidden="true"></div>}
    <a class="skip-link" href="#main">跳到主要内容</a>
    {showNavigation && <SiteHeader />}
    <main id="main" class:list={["page-main", { "page-main--wide": wide }]} data-route-main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initRouteMotion } from "../scripts/route-motion";
      import { initSmoothCorners } from "../scripts/smooth-corners";
      import { initDetailRouteTransitions } from "../scripts/detail-route-transitions";
      import "../scripts/list-sounds";
      import "../scripts/project-cover-transitions";
      import "../scripts/code-blocks";

      initRouteMotion();
      initSmoothCorners();
      initDetailRouteTransitions();
    </script>
  </body>
</html>
