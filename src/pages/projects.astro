---
import { thumbImage } from "../lib/display-image";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectFilters from "../components/ProjectFilters.astro";
import { projectStackStyle } from "../lib/project-stack";
import { getProjects } from "../lib/projects";
import { getProjectCategory } from "../lib/project-badges";

const projects = await getProjects();
const description = "这里收录了我近几年参与的项目与根据自己需求所做产品。每一个我都认真投入，也在一次次实践中逐渐成长。";
if (projects.length === 0) return Astro.redirect("/", 302);
const archiveProjectPreviews = projects.map((project) => ({
  source: project.id,
  category: getProjectCategory(project.id),
  title: project.data.title,
  summary: project.data.description,
  period: project.data.period,
  images: Array.from({ length: 3 }, (_, index) => project.data.archiveImages[index] ?? project.data.cover ?? "/assets/figma-v03/project-detail/cover.png"),
  href: `/projects/${project.id}`,
}));
---

<BaseLayout title="作品" titleEn="Work" description={description}>
  <header class="page-intro reading-column">
    <h1 data-route-enter>作品</h1>
    <p data-route-enter>{description}</p>
  </header>
  <section class="archive-section reading-column" aria-label="作品列表">
    <ProjectFilters id="project-categories" rememberSelection>
      <div class="project-archive-list" data-project-archive-list data-route-enter-group>
        {archiveProjectPreviews.map((project) =>
          <a class="project-archive-row" href={project.href} data-list-sound data-project-transition data-project-source={project.source} data-project-category={project.category}>
            <span class="project-archive-row__thumb" aria-hidden="true">
              {/* The editor lists front to back; paint the stack back to front. */}
              {[...project.images].reverse().map((image, index) => <img src={thumbImage(image)} alt="" decoding="async" loading="lazy" style={projectStackStyle(project.source, index)} />)}
            </span>
            <span class="project-archive-row__copy"><strong>{project.title}</strong><small>{project.summary}</small></span>
            <span class="project-archive-row__time">{project.period}</span>
          </a>)}
      </div>
    </ProjectFilters>
  </section>
</BaseLayout>
