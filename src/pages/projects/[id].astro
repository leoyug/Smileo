---
import { readingImage } from "../../lib/display-image";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getProjects } from "../../lib/projects";
import DetailToc from "../../components/DetailToc.astro";
import ProjectFacts from "../../components/ProjectFacts.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleImageZoom from "../../components/ArticleImageZoom.astro";
import Button from "../../components/Button.astro";
import TextLink from "../../components/TextLink.astro";
import ProjectCaseContent from "../../components/projects/ProjectCaseContent.astro";
import YiwoCaseMedia from "../../components/projects/yiwo-admin/YiwoCaseMedia.astro";
import ZhaichangxiangCaseNotes from "../../components/projects/ZhaichangxiangCaseNotes.astro";
import ZhaichangxiangSiteStructure from "../../components/projects/ZhaichangxiangSiteStructure.astro";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"projects">; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const cover = entry.data.cover ?? "/assets/figma-v03/project-detail/cover.png";
const isZhaichangxiangWebsite = entry.id === "zhaichangxiang-website";
---

<BaseLayout title={`${entry.data.title}`} description={entry.data.description} socialImage={cover}>
  <DetailToc headings={headings} ariaLabel="项目目录" className="detail-toc--reading" backHref="/projects" backLabel="返回项目" returnViaHistory />
  <article class="content-detail reading-column content-detail--project-case" data-detail-page="project" data-project-id={entry.id} data-route-enter-viewport>
    <img class="content-detail__cover" src={readingImage(cover)} alt={`${entry.data.title}项目封面`} transition:name="project-cover" data-route-enter />
    <header id="overview" data-route-enter>
      <div class="project-heading">
        <h1>{entry.data.title}</h1>
        {entry.data.download && (
          <a
            class="project-download"
            href={entry.data.download.href}
            download={entry.data.download.filename}
            aria-label={entry.data.download.label}
          >
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 3.25v8.5M6.75 8.75 10 12l3.25-3.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4.25 15.75h11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </a>
        )}
        {isZhaichangxiangWebsite && entry.data.website && (
          <Button href={entry.data.website} size="small" class="project-website-visit">
            访问网站
            <span class="project-website-visit__icon" aria-hidden="true"></span>
          </Button>
        )}
      </div>
      {!isZhaichangxiangWebsite && <p class="project-subtitle">{entry.data.description}</p>}
      <ProjectFacts role={entry.data.role} projectType={entry.data.projectType} period={entry.data.period} tools={entry.data.tools} />
      {!isZhaichangxiangWebsite && entry.data.website && <p><TextLink href={entry.data.website}>{entry.data.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}</TextLink></p>}
    </header>
    {entry.id === "yiwo-admin" ? (
      <ProjectCaseContent>
        <Content />
        <YiwoCaseMedia slot="problems" section="problems" />
        <YiwoCaseMedia slot="directions" section="directions" />
        <YiwoCaseMedia slot="layout" section="layout" />
        <YiwoCaseMedia slot="visual-language" section="visual-language" />
        <YiwoCaseMedia slot="navigation" section="navigation" />
        <YiwoCaseMedia slot="plan-card" section="plan-card" />
        <YiwoCaseMedia slot="reports" section="reports" />
        <YiwoCaseMedia slot="empty-states" section="empty-states" />
        <YiwoCaseMedia slot="final-screens" section="final-screens" />
        <YiwoCaseMedia slot="results" section="results" />
      </ProjectCaseContent>
    ) : isZhaichangxiangWebsite ? (
      <ProjectCaseContent>
        <Content />
        <ZhaichangxiangCaseNotes slot="design-goals" section="goals" />
        <ZhaichangxiangSiteStructure slot="website-structure" id="zhaichangxiang-site-structure" />
        <ZhaichangxiangCaseNotes slot="reflection-notes" section="reflection" />
      </ProjectCaseContent>
    ) : <div class="article__body" id="content" data-route-enter-body><Content /></div>}
    <span id="reflection" class="detail-anchor" aria-hidden="true"></span>
  </article>
  <ArticleImageZoom />
</BaseLayout>

<style>
  .project-heading :global(.project-website-visit) {
    flex: none;
    align-self: end;
    margin-block-end: var(--space-1);
    gap: calc(var(--space-1) / 2);
    min-block-size: var(--space-8);
    border-radius: var(--radius-sm);
    box-shadow: none;
    font-size: var(--text-meta);
    font-weight: var(--weight-regular);
    line-height: var(--space-5);
  }

  .project-website-visit__icon {
    inline-size: var(--space-4);
    block-size: var(--space-4);
    background: currentColor;
    mask: url("/assets/figma/zhaichangxiang-website/visit-arrow.svg") center no-repeat;
  }

  @media (pointer: coarse) {
    .project-heading :global(.project-website-visit) {
      min-block-size: var(--dock-control-size);
    }
  }

  @media (max-width: 24rem) {
    :global(html:lang(en)) .project-heading:has(:global(.project-website-visit)) {
      flex-wrap: wrap;
      row-gap: var(--space-2);
    }
  }
</style>
